# Copy this file to .env.live and replace every placeholder before the first Dasani deploy.
#
# This is the Dasani Enterprises production tenant — fully isolated from the
# testinglinq.com stack (separate Postgres, separate Redis, separate ports,
# separate secrets). See docker-compose.dasani.yml / ecosystem.dasani.config.js /
# deploy/deploy-dasani.sh.
#
# This file is used by:
#   1. docker-compose.dasani.yml  — Compose-time variable interpolation for PostgreSQL / Redis
#   2. deploy/deploy-dasani.sh    — Sourced into the shell so Nx builds receive NEXT_PUBLIC_*
#                                   vars at compile time and pm2 captures secrets at start time
#
# IMPORTANT: DATABASE_URL must use 127.0.0.1:5433 (Dasani's Postgres loopback
# port), NOT 5432 (that's wscrm-postgres / testinglinq) and NOT the Docker
# service name "dasani-postgres" — the API backend runs on the host, not inside Docker.

# ─── Required: PostgreSQL container bootstrap ──────────────────────────────────
POSTGRES_USER=dasani
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=dasani_water_crm

# ─── Required: NestJS database connection (host → Docker loopback port) ────────
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
DATABASE_URL=postgresql://dasani:replace-with-a-long-random-password@127.0.0.1:5433/dasani_water_crm?schema=public
DIRECT_DATABASE_URL=postgresql://dasani:replace-with-a-long-random-password@127.0.0.1:5433/dasani_water_crm?schema=public

# ─── Required: backend auth / API base URLs ────────────────────────────────────
# Generate NEW secrets — do NOT reuse the testinglinq.com .env.prod secrets.
# e.g. openssl rand -base64 48
JWT_SECRET=replace-with-a-32-plus-char-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-32-plus-char-random-secret
ALLOWED_ORIGINS=https://admin.dasanienterprises.com,https://vendor.dasanienterprises.com,https://app.dasanienterprises.com
NEXT_PUBLIC_API_URL=https://api.dasanienterprises.com/api

# ─── Optional: email-based password resets ─────────────────────────────────────
# Limitation: the backend currently supports one reset-link base URL via FRONTEND_URL.
FRONTEND_URL=https://admin.dasanienterprises.com/auth
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USER=postmaster@dasanienterprises.com
MAIL_PASS=replace-with-smtp-password
MAIL_FROM="Dasani Enterprises <noreply@dasanienterprises.com>"

# ─── Optional: S3-compatible object storage for screenshots / attachments ──────
# Use a separate bucket (or at minimum a separate prefix) from testinglinq's
# to avoid any cross-tenant key collisions.
WASABI_ACCESS_KEY_ID=replace-with-access-key
WASABI_SECRET_ACCESS_KEY=replace-with-secret-key
WASABI_REGION=ap-southeast-1
WASABI_BUCKET=dasani-uploads
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com

# ─── Optional: Paymob / Raast payment integration ──────────────────────────────
API_URL=https://api.dasanienterprises.com/api
PAYMOB_API_KEY=replace-with-paymob-api-key
PAYMOB_RAAST_INTEGRATION_ID=replace-with-integration-id
PAYMOB_HMAC_SECRET=replace-with-hmac-secret
PAYMOB_BASE_URL=https://accept.paymob.com/api

# ─── Optional: vendor live-tracking map (Google Maps) ─────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=replace-with-google-maps-map-id

# ─── Optional: browser-side Firebase config for push notifications ─────────────
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-web-api-key
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-firebase-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-firebase-project.appspot.com
NEXT_PUBLIC_FIREBASE_VAPID_KEY=replace-with-web-push-vapid-key
NEXT_PUBLIC_FIREBASE_MESSAGING_VAPID_KEY=

# ─── Optional: Firebase Admin SDK for backend FCM delivery ─────────────────────
FIREBASE_PROJECT_ID=replace-with-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@replace-with-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"

# ─── Optional: WhatsApp — Meta Cloud API (official Business Platform) ──────────
WHATSAPP_ENABLED=false
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
# META_WA_API_VERSION=v21.0

# ─── Optional: backend logging ─────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Dasani-specific: Redis, loopback port only (dasani-redis container) ───────
# Ecosystem file hard-codes these too (see infraOverrides in ecosystem.dasani.config.js)
# but keep them here so any local tooling reading .env.live directly stays consistent.
REDIS_URL=redis://127.0.0.1:6380
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
