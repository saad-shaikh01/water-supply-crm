generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")        // PgBouncer URL (transaction mode) in production
  directUrl = env("DIRECT_DATABASE_URL") // Direct DB URL — used by Prisma migrate only
}

enum PaymentType {
  MONTHLY
  CASH
}

enum UserRole {
  SUPER_ADMIN
  VENDOR_ADMIN
  STAFF
  DRIVER
  SALESMAN
  LOADER
  CUSTOMER
}

// Role a person performs on a specific van/trip. Kept separate from UserRole
// (auth) so a spare DRIVER-role user can ride along as a LOADER, and future
// roles (e.g. HELPER, SUPERVISOR) are a one-line addition.
enum CrewRole {
  DRIVER
  SALESMAN
  LOADER
}

enum DeliveryStatus {
  PENDING
  COMPLETED
  EMPTY_ONLY
  NOT_AVAILABLE
  RESCHEDULED
  CANCELLED
}

enum DeliveryType {
  SCHEDULED
  ON_DEMAND
}

enum TransactionType {
  DELIVERY
  COLLECTION
  PAYMENT
  ADJUSTMENT
  LOAD_OUT
  CHECK_IN
}

enum ExpenseCategory {
  LUNCH_EXPENSE_EMPLOYEE
  ADVANCE_SALARY_EMPLOYEE
  VEHICLE_MAINTENANCE
  FUEL_EXPENSE
  OTHER
}

enum DamageSeverity {
  MINOR
  MODERATE
  SEVERE
}

enum DamageCaseStatus {
  REPORTED
  UNDER_REVIEW
  CHARGED
  WAIVED
  REVERSED
}

enum WriteOffCategory {
  CUSTOMER_NEGLIGENCE
  NORMAL_WEAR
  TRANSIT_ACCIDENT
  UNKNOWN
}

enum DamageCaseType {
  DAMAGE
  LOST
}

enum BottleLossReason {
  CUSTOMER_NOT_RETURNED
  CUSTOMER_SAID_LOST
  WRONG_ADDRESS
  OTHER
}

enum WarehouseTransactionType {
  OPENING_BALANCE
  FILL_IN
  LOAD_OUT
  CHECK_IN_FILLED
  CHECK_IN_EMPTY
  CHECK_IN_DAMAGED
  CHECK_IN_LEAKED
  REFILL
  MARK_DAMAGED
  MARK_LEAKED
  SEND_REPAIR
  RETURN_REPAIR
  WRITE_OFF
  DISCREPANCY_ADJUST
  ADJUSTMENT
  AUTO_REFILL
}

enum RepairBatchStatus {
  SENT
  PARTIALLY_RETURNED
  COMPLETED
}

// Renamed from NoteType (Customer Communication Center). IMAGE / FILE / SYSTEM
// are reserved for future phases — add values only when a phase implements them.
enum MessageType {
  TEXT
  VOICE
}

// Customer Communication Center — conversation workflow state. "Waiting on
// driver/office" is DERIVED from lastMessageSenderRole, never stored here.
enum ConversationStatus {
  OPEN
  RESOLVED
  CLOSED
}

// Coarse notification category the vendor can switch on/off per channel.
// Distinct from NotificationPreference (per-recipient user opt-in): this is a
// vendor-level master gate deciding whether a flow is emitted at all.
enum NotificationType {
  DELIVERY_RECEIPT
  MONTHLY_STATEMENT
  PAYMENT_RECEIVED
  ORDER_UPDATE
  TICKET_REPLY
}

enum NotificationChannel {
  WHATSAPP
  PUSH
}

// RBAC per-user override effect. DENY always wins over role grants + ALLOW overrides.
enum PermissionEffect {
  ALLOW
  DENY
}

model Vendor {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  address     String?
  logoUrl     String?
  // Payment settings
  raastId     String?  // Vendor's Raast ID for static QR / reference
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                   User[]
  products                Product[]
  customers               Customer[]
  vans                    Van[]
  routes                  Route[]
  dailySheets             DailySheet[]
  transactions            Transaction[]
  paymentRequests         PaymentRequest[]
  expenses                Expense[]
  orders                  CustomerOrder[]
  tickets                 CustomerTicket[]
  deliveryIssues          DeliveryIssue[]
  reminderScheduleConfig  ReminderScheduleConfig?
  reminderSendLogs        ReminderSendLog[]
  driverLastLocations     DriverLastLocation[]
  damageCases             DamageCase[]
  conversationMessages    ConversationMessage[]
  conversations           Conversation[]
  warehouseStocks         WarehouseStock[]
  warehouseTransactions   WarehouseTransaction[]
  repairBatches           RepairBatch[]
  notificationSettings    NotificationSetting[]
  roles                   Role[]
  collectionPolicyConfig  CollectionPolicyConfig?
  cashCollectionPolicyConfig CashCollectionPolicyConfig?
  warehouseAutoRefillConfig  WarehouseAutoRefillConfig?

  // Staff Payroll & Financial Management — Phase 1 (Foundation)
  salaryStructures     SalaryStructure[]
  staffLedgerEntries   StaffLedgerEntry[]
  payrollApprovalRules PayrollApprovalRule[]
  payrollVendorConfig  PayrollVendorConfig?
  payrollPeriods       PayrollPeriod[]
  payrollEntries       PayrollEntry[]
  settlements          Settlement[]

  // Crew Operational Cash Distribution — extension to Payroll (see
  // docs/features/crew-operational-cash-distribution.md)
  crewCashDistributions CrewCashDistribution[]
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique // null for no-login staff (SALESMAN/LOADER)
  password      String?  // null = login disabled (no-login staff)
  name          String
  phoneNumber   String?  @unique
  role          UserRole
  isActive      Boolean  @default(true)
  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id])

  // RBAC: assigned custom/preset Role (permission source of truth). The legacy `role`
  // enum above is retained as a coarse category during the RBAC migration (design §13).
  roleId              String?
  roleRef             Role?    @relation("RoleMembers", fields: [roleId], references: [id], onDelete: SetNull)
  permissionOverrides UserPermissionOverride[]

  // Relations for specific roles
  assignedVan         Van?     @relation("VanDriver")
  dailySheets         DailySheet[] @relation("DriverSheets")
  customer            Customer? // One-to-one link for Customer Portal
  expenses            Expense[]
  fcmTokens             FcmToken[]
  inAppNotifications    InAppNotification[]
  notificationPrefs     NotificationPreference[]
  driverLastLocation    DriverLastLocation?
  driverDamageCases     DamageCase[] @relation("DriverDamageCases")
  reviewedDamageCases   DamageCase[] @relation("DamageCaseReviewer")
  sentMessages          ConversationMessage[] @relation("MessageSender")
  conversationsAsDriver Conversation[]         @relation("ConversationDriver")
  conversationReads     ConversationRead[]     @relation("ConversationReader")
  createdWarehouseTx    WarehouseTransaction[] @relation("WarehouseTxCreatedBy")
  createdRepairBatches  RepairBatch[]          @relation("RepairBatchCreatedBy")
  crewAssignments       DailySheetCrew[]       @relation("CrewMember")
  vanDefaultCrew        VanDefaultCrew[]       @relation("VanDefaultCrewMember")
  confirmedCrewSheets   DailySheet[]           @relation("CrewConfirmedBy")

  // Staff Payroll & Financial Management — Phase 1 (Foundation)
  salaryStructures            SalaryStructure[]      @relation("SalaryStructureEmployee")
  createdSalaryStructures     SalaryStructure[]      @relation("SalaryStructureCreatedBy")
  staffLedgerEntries          StaffLedgerEntry[]      @relation("StaffLedgerEntryEmployee")
  createdStaffLedgerEntries   StaffLedgerEntry[]      @relation("StaffLedgerEntryCreatedBy")
  approvedStaffLedgerEntries  StaffLedgerEntry[]      @relation("StaffLedgerEntryApprovedBy")
  staffLedgerAuditLogs        StaffLedgerAuditLog[]
  updatedPayrollApprovalRules PayrollApprovalRule[]
  updatedPayrollVendorConfigs PayrollVendorConfig[]
  lockedPayrollPeriods        PayrollPeriod[]
  payrollEntries              PayrollEntry[]          @relation("PayrollEntryEmployee")
  approvedPayrollEntries      PayrollEntry[]          @relation("PayrollEntryApprovedBy")
  createdPayrollSnapshots     PayrollSnapshot[]
  payrollEntryAuditLogs       PayrollEntryAuditLog[]
  paidSettlements             Settlement[]

  // Crew Operational Cash Distribution
  distributedCrewCash  CrewCashDistribution[]           @relation("CrewCashDistributedBy")
  receivedCrewCash     CrewCashDistribution[]           @relation("CrewCashEmployee")
  approvedCrewCash     CrewCashDistribution[]           @relation("CrewCashApprovedBy")
  createdCrewCash      CrewCashDistribution[]           @relation("CrewCashCreatedBy")
  crewCashAuditLogs    CrewCashDistributionAuditLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vendorId])
  @@index([roleId])
}

// ──────────────────────────────────────────────────────────────────────────────
// RBAC — Roles & Permissions (see docs/rbac-permission-catalog.md, frozen)
// Permission strings live in code (@water-supply-crm/authz); these tables store only
// grants. Wildcards ("*", "resource:*") are valid permission values.
// ──────────────────────────────────────────────────────────────────────────────

// A named bundle of permissions. System roles (isSystem=true) are seeded per vendor
// from ROLE_PRESETS and cannot be deleted; their `key` is locked. vendorId is null
// only for the global super_admin template.
model Role {
  id          String   @id @default(uuid())
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  key         String   // stable machine key, e.g. "vendor_admin" — unique per vendor
  name        String   // editable display name
  description String?
  color       String?  // UI chip color
  isSystem    Boolean  @default(false) // preset role — key locked, non-deletable
  isDefault   Boolean  @default(false) // auto-assigned to new users of a category

  permissions RolePermission[]
  users       User[]   @relation("RoleMembers")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vendorId, key])
  @@index([vendorId])
}

// A single permission grant on a role. Presence = granted. `permission` is validated
// against the code catalog on write; may be an exact permission or a wildcard.
model RolePermission {
  id         String   @id @default(uuid())
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@unique([roleId, permission])
  @@index([roleId])
}

// Per-user override layered on top of role permissions. DENY always wins; expiresAt
// enables temporary permissions (a periodic job prunes expired rows).
model UserPermissionOverride {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission  String
  effect      PermissionEffect
  expiresAt   DateTime?        // null = permanent
  grantedById String?          // granter's user id — soft ref, no FK (matches AuditLog)
  createdAt   DateTime         @default(now())

  @@unique([userId, permission])
  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  basePrice   Float
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  isActive    Boolean  @default(true)

  wallets     BottleWallet[]
  sheetItems  DailySheetItem[]
  transactions Transaction[]
  customPrices CustomerProductPrice[]
  orders      CustomerOrder[]
  damageCases DamageCase[]
  warehouseStocks       WarehouseStock[]
  warehouseTransactions WarehouseTransaction[]
  repairBatches         RepairBatch[]
  loads                 DailySheetLoad[]       @relation("LoadProduct")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId, isActive])
  @@index([vendorId, name])
}

model Customer {
  id            String   @id @default(uuid())
  customerCode  String   @unique
  name          String
  phoneNumber   String

  // Location
  address              String
  floor                String?  // e.g. "2nd Floor", "Flat 3B"
  nearbyLandmark       String?  // e.g. "Near McDonald's", "Opposite mosque"
  deliveryInstructions String?  // e.g. "Call before arriving", "Leave at gate"
  googleMapsUrl        String?  // Full Google Maps share URL (lat/lng parsed on frontend)
  latitude             Float?
  longitude            Float?

  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])

  routeId       String?  // Optional "home route" for organizational grouping only
  route         Route?   @relation(fields: [routeId], references: [id])

  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id])

  paymentType      PaymentType @default(CASH)
  isActive         Boolean     @default(true)
  isBillingExempt  Boolean     @default(false)
  financialBalance Float       @default(0) // Current outstanding amount (running balance)

  wallets           BottleWallet[]
  customPrices      CustomerProductPrice[]
  sheetItems        DailySheetItem[]
  transactions      Transaction[]
  paymentRequests   PaymentRequest[]
  deliverySchedules CustomerDeliverySchedule[]
  orders            CustomerOrder[]
  tickets           CustomerTicket[]
  damageCases       DamageCase[]
  conversations     Conversation[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vendorId])
  @@index([vendorId, routeId])
  @@index([routeId])
}

model CustomerDeliverySchedule {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vanId         String
  van           Van      @relation(fields: [vanId], references: [id])
  dayOfWeek     Int      // 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  routeSequence Int?     // Position in van's delivery order on this day
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([customerId, dayOfWeek])
  @@index([vanId, dayOfWeek])
}

model CustomerProductPrice {
  id          String   @id @default(uuid())
  customerId  String
  productId   String
  customPrice Float
  
  customer    Customer @relation(fields: [customerId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
}

model BottleWallet {
  id          String   @id @default(uuid())
  customerId  String
  productId   String
  balance     Int      @default(0) // Current bottles at customer location
  
  customer    Customer @relation(fields: [customerId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
}

model Route {
  id            String   @id @default(uuid())
  name          String
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])

  defaultVanId  String?
  defaultVan    Van?     @relation("RouteDefaultVan", fields: [defaultVanId], references: [id])

  customers     Customer[]
  dailySheets   DailySheet[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vendorId])
}

model Van {
  id            String   @id @default(uuid())
  plateNumber   String   @unique
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  
  isActive        Boolean @default(true)
  defaultDriverId String? @unique
  defaultDriver   User?   @relation("VanDriver", fields: [defaultDriverId], references: [id])

  routes            Route[]  @relation("RouteDefaultVan")
  dailySheets       DailySheet[]
  expenses          Expense[]
  deliverySchedules CustomerDeliverySchedule[]
  defaultCrew       VanDefaultCrew[]
  conversations     Conversation[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Template crew for a van — copied onto each generated DailySheet.
// The default DRIVER stays on Van.defaultDriverId (workflow-critical);
// this table holds the supporting crew (salesman, loaders, future roles).
model VanDefaultCrew {
  id     String   @id @default(uuid())
  vanId  String
  van    Van      @relation(fields: [vanId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation("VanDefaultCrewMember", fields: [userId], references: [id])
  role   CrewRole

  createdAt DateTime @default(now())

  @@unique([vanId, userId])
  @@index([userId])
}

model DailySheet {
  id            String   @id @default(uuid())
  date          DateTime
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  
  routeId       String?
  route         Route?   @relation(fields: [routeId], references: [id])
  
  vanId         String
  van           Van      @relation(fields: [vanId], references: [id])
  
  driverId      String
  driver        User     @relation("DriverSheets", fields: [driverId], references: [id])

  isClosed      Boolean  @default(false)

  // Crew confirmation workflow — the day's crew (auto-stamped from the van's
  // default crew) must be explicitly confirmed before any trip can start.
  // Any crew/driver change resets crewConfirmed to false.
  crewConfirmed     Boolean   @default(false)
  crewConfirmedAt   DateTime?
  crewConfirmedById String?
  crewConfirmedBy   User?     @relation("CrewConfirmedBy", fields: [crewConfirmedById], references: [id])

  // Reconciliation fields
  filledOutCount Int     @default(0)
  filledInCount  Int     @default(0)
  emptyInCount   Int     @default(0)
  cashExpected   Float   @default(0)
  cashCollected  Float   @default(0)

  items         DailySheetItem[]
  transactions  Transaction[]
  loads         DailySheetLoad[]
  expenses      Expense[]
  warehouseTransactions WarehouseTransaction[]
  crew          DailySheetCrew[]
  conversations Conversation[]
  crewCashDistributions CrewCashDistribution[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([vendorId, vanId, date])
  @@index([vendorId, date])
  @@index([vendorId, routeId, date])
  @@index([driverId, date])
  @@index([vanId, date])
}

// Snapshot of the supporting crew (salesman, loaders) that actually went out
// on this sheet's van. The driver is NOT duplicated here — DailySheet.driverId
// remains the single source of truth for the accountable driver.
model DailySheetCrew {
  id           String     @id @default(uuid())
  dailySheetId String
  dailySheet   DailySheet @relation(fields: [dailySheetId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("CrewMember", fields: [userId], references: [id])
  role         CrewRole

  createdAt DateTime @default(now())

  @@unique([dailySheetId, userId])
  @@index([userId])
  @@index([dailySheetId])
}

model DailySheetLoad {
  id             String     @id @default(uuid())
  dailySheetId   String
  dailySheet     DailySheet @relation(fields: [dailySheetId], references: [id], onDelete: Cascade)
  tripNumber     Int        // 1, 2, 3...
  loadedFilled   Int        // filled bottles taken from warehouse at trip start
  returnedFilled Int        @default(0)  // filled returned at end of trip
  collectedEmpty Int        @default(0)  // empties collected from customers
  cashHandedIn   Float      @default(0)  // cash given to warehouse at check-in
  productId      String?    // which product was loaded (null = legacy records)
  product        Product?   @relation("LoadProduct", fields: [productId], references: [id])
  damagedOnVan   Int        @default(0)  // bottles damaged during transit
  leakedOnVan    Int        @default(0)  // bottles that leaked during transit
  startedAt      DateTime   @default(now())
  endedAt        DateTime?  // null = trip still in progress

  @@index([dailySheetId])
  @@index([dailySheetId, tripNumber])
  @@index([productId])
}

model DailySheetItem {
  id            String   @id @default(uuid())
  dailySheetId  String
  dailySheet    DailySheet @relation(fields: [dailySheetId], references: [id])
  
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  
  sequence      Int
  status        DeliveryStatus @default(PENDING)
  deliveryType  DeliveryType   @default(SCHEDULED)
  sourceOrderId String?

  filledDropped  Int   @default(0)
  emptyReceived  Int   @default(0)
  // Already-filled bottles received back from the customer (account closing,
  // excess stock return) — separate from emptyReceived: no wash/refill needed,
  // ready to reload immediately. Financially treated the same as emptyReceived
  // (reduces the bottle wallet, no charge) but tracked as its own count.
  filledReceived Int   @default(0)
  cashCollected  Float @default(0)
  pricePerBottle Float @default(0)
  bottleBalanceAfter    Int?
  financialBalanceAfter Float?

  reason          String?  // Free text notes for unable-to-deliver
  failureCategory String?  // CUSTOMER_NOT_HOME | CUSTOMER_NOT_ANSWERING | CUSTOMER_SELF_PICKUP | VAN_BREAKDOWN | ACCESS_ISSUE | CUSTOMER_REFUSED | WEATHER | OTHER
  photoKey        String?  // Optional photo evidence (Wasabi object key)
  deliveredAt     DateTime?  // Set when delivery is COMPLETED or EMPTY_ONLY
  rescheduledTo DateTime?
  editUnlockedBy      String?    // userId of staff/admin who unlocked edit
  editUnlockExpiresAt DateTime?  // when unlock window expires (null = locked)
  editRequestedAt     DateTime?  // set when driver requests edit; cleared on admin unlock
  whatsappSentAt      DateTime?  // set when delivery-complete WhatsApp is successfully sent

  isCorrection       Boolean   @default(false)   // true when added to a closed sheet retroactively
  correctionAddedAt  DateTime?                   // timestamp when correction was recorded
  correctionNote     String?                     // mandatory reason (required by service layer)

  deliveryIssue DeliveryIssue?
  transactions  Transaction[]
  damageCases   DamageCase[]
  // Relation field kept as `notes` through the Communication Center migration
  // so daily-sheet includes stay stable; renamed to `messages` in Phase 7.
  notes         ConversationMessage[]
  // Non-unique now — a DailySheetItem can be the "last discussed delivery"
  // rollup pointer for at most one Conversation in practice, but the FK
  // itself is no longer @unique (Conversation is keyed per-customer).
  conversationsLastDiscussed Conversation[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dailySheetId, sequence])
  @@index([dailySheetId, customerId])
  @@index([customerId, status])
}

model DeliveryIssue {
  id               String              @id @default(uuid())
  vendorId         String
  vendor           Vendor              @relation(fields: [vendorId], references: [id])

  dailySheetItemId String              @unique
  dailySheetItem   DailySheetItem      @relation(fields: [dailySheetItemId], references: [id])

  status           DeliveryIssueStatus @default(OPEN)

  // Plan fields
  nextAction       IssueNextAction?
  retryAt          DateTime?
  assignedToUserId String?
  assignedVanId    String?
  assignedDriverId String?
  planNotes        String?
  plannedAt        DateTime?
  plannedById      String?

  // Resolution fields
  resolution       IssueResolution?
  resolvedNotes    String?
  resolvedAt       DateTime?
  resolvedById     String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([vendorId, status])
  @@index([vendorId, createdAt])
  @@index([assignedVanId])
}

model Transaction {
  id            String   @id @default(uuid())
  type          TransactionType
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id])
  
  dailySheetId     String?
  dailySheet       DailySheet?     @relation(fields: [dailySheetId], references: [id])

  dailySheetItemId String?
  dailySheetItem   DailySheetItem? @relation(fields: [dailySheetItemId], references: [id], onDelete: SetNull)

  bottleCount    Int?     // NET change to wallet (filledDropped - emptyReceived - filledReceived)
  filledDropped  Int?     // Filled bottles given to customer (consumption indicator)
  emptyReceived  Int?     // Empty bottles collected from customer (needs refill/wash)
  filledReceived Int?     // Already-filled bottles collected back from customer (no refill needed)
  amount         Float?   // Positive for charge, negative for payment

  description   String?
  damageCase    DamageCase?

  createdAt     DateTime @default(now())

  @@index([vendorId, createdAt])
  @@index([customerId, createdAt])
  @@index([dailySheetId])
  @@index([dailySheetItemId])
  @@index([vendorId, type, createdAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Payment Requests
// ──────────────────────────────────────────────────────────────────────────────

// ──────────────────────────────────────────────────────────────────────────────
// Customer Orders & Support Tickets
// ──────────────────────────────────────────────────────────────────────────────

enum DeliveryIssueStatus {
  OPEN
  PLANNED
  IN_RETRY
  RESOLVED
  DROPPED
}

enum IssueNextAction {
  RETRY_SAME_DAY
  RETRY_ON_DATE_TIME
  MOVE_TO_NEXT_REGULAR_DAY
  SELF_PICKUP
  CANCEL_ONE_OFF
  PERMANENT_STOP
}

enum IssueResolution {
  DELIVERED
  SELF_PICKUP_DONE
  DROPPED
  CANCELLED
}

enum DispatchStatus {
  UNPLANNED
  PLANNED
  INSERTED_IN_SHEET
  DELIVERED
  FAILED
  SELF_PICKUP_DONE
  CANCELLED
}

enum DispatchMode {
  INSERT_IN_OPEN_SHEET
  QUEUE_FOR_GENERATION
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TicketType {
  FEEDBACK
  COMPLAINT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model CustomerOrder {
  id              String      @id @default(cuid())
  vendorId        String
  customerId      String
  productId       String
  quantity        Int
  status          OrderStatus @default(PENDING)
  note            String?
  preferredDate   DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  // Dispatch planning
  dispatchStatus   DispatchStatus @default(UNPLANNED)
  targetDate       DateTime?
  timeWindow       String?
  dispatchVanId    String?
  dispatchDriverId String?
  dispatchMode     DispatchMode?
  dispatchNotes    String?
  plannedAt        DateTime?
  plannedById      String?
  dispatchedAt     DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([vendorId, status])
  @@index([vendorId, dispatchStatus])
  @@index([customerId])
  @@index([customerId, status])
}

model CustomerTicket {
  id          String         @id @default(cuid())
  vendorId    String
  customerId  String
  type        TicketType
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  vendorReply String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  messages TicketMessage[]

  @@index([vendorId, status])
  @@index([customerId])
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      CustomerTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole  String   // "CUSTOMER" | "VENDOR"
  senderId    String
  message     String
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

enum PaymentRequestStatus {
  PENDING     // Manual: submitted by customer, waiting vendor review
              // Raast QR: QR generated, waiting scan
  PROCESSING  // Raast QR: customer scanning / payment in progress
  PAID        // Gateway confirmed payment (Raast QR auto-approved)
  APPROVED    // Vendor manually approved (manual payments)
  REJECTED    // Vendor rejected
  EXPIRED     // QR expired without payment
  CANCELLED   // Customer cancelled
}

enum PaymentMethod {
  RAAST_QR          // Automated via Paymob — QR generated, customer scans
  MANUAL_RAAST      // Customer paid via Raast, submitted reference number
  MANUAL_JAZZCASH   // Customer paid via JazzCash, submitted reference
  MANUAL_EASYPAISA  // Customer paid via Easypaisa, submitted reference
  MANUAL_BANK       // Customer paid via bank transfer / IBFT
}

model PaymentRequest {
  id         String               @id @default(uuid())
  vendorId   String
  customerId String
  amount     Float

  method  PaymentMethod
  status  PaymentRequestStatus @default(PENDING)

  // ── Raast QR (automated) ─────────────────────────────────────────────
  gatewayOrderId  String?   // Paymob order ID
  gatewayTxId     String?   // Paymob transaction ID (set on webhook)
  checkoutUrl     String?   // Paymob hosted checkout URL
  qrCodeData      String?   // QR image base64 or URL (if returned by gateway)
  qrExpiresAt     DateTime? // QR expiry (typically 10-15 min)

  // ── Manual payment ───────────────────────────────────────────────────
  referenceNo    String?   // Transaction ID / reference entered by customer
  screenshotPath String?   // Local path to uploaded screenshot
  customerNote   String?   // Optional message from customer

  // ── Review (vendor) ──────────────────────────────────────────────────
  reviewedBy      String?   // userId of vendor admin who approved/rejected
  reviewedAt      DateTime?
  rejectionReason String?

  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, status])
  @@index([customerId])
  @@index([gatewayOrderId])
  @@index([vendorId, createdAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Expense Tracking
// ──────────────────────────────────────────────────────────────────────────────

model Expense {
  id          String          @id @default(uuid())
  vendorId    String
  vendor      Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Float
  description String
  date        DateTime
  vanId       String?
  van         Van?            @relation(fields: [vanId], references: [id])
  dailySheetId String?
  dailySheet   DailySheet? @relation(fields: [dailySheetId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([vendorId, date])
  @@index([vendorId, category])
  @@index([dailySheetId])
}

// Crew Cash Distribution (docs/features/crew-operational-cash-distribution.md) —
// a Daily-Sheet-scoped record of company cash the Salesman hands to a crew
// member on the route (meal/tea/water/etc). Mutable while the sheet is open
// (mirrors Expense exactly); synced into one StaffLedgerEntry per row at the
// moment the sheet closes (§6), never re-typed. `amount` here is always a
// positive magnitude — the debit sign is applied only on the StaffLedgerEntry
// created at sync, matching the source-record-vs-financial-consequence split
// in §8 of the doc.
//
// Two independent identities per §2 (the doc's central modeling decision):
// distributedById = the custodian who recorded/handed out the cash (zero
// financial consequence for them); employeeId = the beneficiary whose pay is
// debited. A Salesman buying his own lunch is simply both fields on one row —
// no special-casing needed.
model CrewCashDistribution {
  id           String       @id @default(uuid())
  vendorId     String
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  dailySheetId String
  dailySheet   DailySheet   @relation(fields: [dailySheetId], references: [id], onDelete: Cascade)

  distributedById String
  distributedBy   User   @relation("CrewCashDistributedBy", fields: [distributedById], references: [id])
  employeeId      String
  employee        User   @relation("CrewCashEmployee", fields: [employeeId], references: [id])

  category CrewCashCategory
  amount   Int // whole rupees, positive magnitude — see model comment
  notes    String?
  photoKeys String[] // optional receipt/attachment keys — mirrors DamageCase.photoKeys
  date     DateTime // defaults to dailySheet.date at creation, not independently editable

  // Approval gate (§6) — reuses the same PayrollApprovalRule table from Payroll
  // Phase 1 (categoryKey e.g. "CREW_CASH_EMERGENCY"), no new config surface.
  // requiresApproval is snapshotted at creation time (the rule that applied then);
  // a later threshold change never silently reinterprets an already-recorded row.
  requiresApproval Boolean   @default(false)
  approvedById     String?
  approvedBy       User?     @relation("CrewCashApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?

  // Sync (§6) — set exactly once, at the DailySheet's isClosed transition, inside
  // the same idempotency-checked write closeSheet() already performs for its own
  // reconciliation. Null until synced; the row (and its linked StaffLedgerEntry)
  // is frozen from this point on — corrections go through the Payroll Doc's
  // Reversal/Correction mechanic on the linked entry, never a direct edit (§9).
  syncedAt            DateTime?
  syncedLedgerEntryId String?           @unique
  syncedLedgerEntry   StaffLedgerEntry? @relation(fields: [syncedLedgerEntryId], references: [id])

  createdById String
  createdBy   User     @relation("CrewCashCreatedBy", fields: [createdById], references: [id])
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditLogs CrewCashDistributionAuditLog[]

  @@index([vendorId, dailySheetId])
  @@index([vendorId, employeeId])
  @@index([dailySheetId])
  @@index([syncedLedgerEntryId])
}

// Per-entity audit trail, mirroring StaffLedgerAuditLog/DamageCaseAuditLog exactly
// (§10 of the doc). reason is enforced mandatory at the application layer for
// REVERSED/CORRECTED, nullable here since CREATED/EDITED/DELETED don't require one.
model CrewCashDistributionAuditLog {
  id                     String                @id @default(uuid())
  crewCashDistributionId String
  crewCashDistribution   CrewCashDistribution  @relation(fields: [crewCashDistributionId], references: [id])
  actorId                String
  actor                  User                  @relation(fields: [actorId], references: [id])
  actorRole              UserRole
  action                 CrewCashAuditAction
  beforeJson             Json?
  afterJson              Json?
  reason                 String?
  createdAt              DateTime              @default(now())

  @@index([crewCashDistributionId])
  @@index([crewCashDistributionId, createdAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// FCM Push Tokens
// ──────────────────────────────────────────────────────────────────────────────

model FcmToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // "android" | "ios" | "web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Audit Log
// ──────────────────────────────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(uuid())
  vendorId  String?
  userId    String?
  userName  String?
  action    String   // "CREATE" | "UPDATE" | "DELETE" | "APPROVE" | "REJECT" | "SUSPEND" etc.
  entity    String   // "Customer" | "Payment" | "User" etc.
  entityId  String?
  changes   Json?    // { before: {}, after: {} }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, createdAt])
  @@index([entity, entityId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Notification Platform
// ──────────────────────────────────────────────────────────────────────────────

model InAppNotification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String?
  type      String    // e.g. ORDER_APPROVED | TICKET_REPLIED | PAYMENT_APPROVED
  title     String
  message   String
  entityId  String?   // orderId, ticketId, paymentRequestId, etc.
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String   // e.g. order.approved
  channel   String   // WHATSAPP | SMS | FCM | IN_APP
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([userId, eventType, channel])
  @@index([userId])
}

// Vendor-level master switch for a notification flow on a given channel.
// A missing row means "enabled" (default), so vendors only store overrides.
model NotificationSetting {
  id        String              @id @default(uuid())
  vendorId  String
  vendor    Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([vendorId, type, channel])
  @@index([vendorId])
}

model NotificationLog {
  id               String    @id @default(uuid())
  channel          String    // WHATSAPP | SMS | FCM | IN_APP
  status           String    // SENT | FAILED | SKIPPED
  recipientAddress String?   // phone number or FCM userId
  eventType        String?   // e.g. order.approved
  entityType       String?   // ORDER | PAYMENT | TICKET
  entityId         String?
  recipientType    String?   // CUSTOMER | USER
  recipientId      String?
  vendorId         String?
  attemptCount     Int       @default(1)
  lastError        String?
  queuedAt         DateTime
  sentAt           DateTime?
  failedAt         DateTime?
  createdAt        DateTime  @default(now())

  @@index([channel, status])
  @@index([vendorId, createdAt])
  @@index([createdAt])
}
// ──────────────────────────────────────────────────────────────────────────────
// Balance Reminder Schedule Config
// ──────────────────────────────────────────────────────────────────────────────

model ReminderScheduleConfig {
  id             String   @id @default(uuid())
  vendorId       String   @unique
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  cronExpression String
  minBalance     Int      @default(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([vendorId])
}

/// Monthly Customer Collection Policy — vendor-configurable minimum-collection
/// floor evaluated against the customer's remaining previous month outstanding.
/// Missing row = policy disabled (mirrors NotificationSetting's convention).
/// Toggle for the nightly auto-refill job (docs discussion 2026-08-04): when
/// enabled, the warehouse-auto-refill cron converts all warehouse emptyCount
/// into filledCount every night, right after daily sheet auto-generation.
/// Temporary/reversible by design — missing row or enabled=false means the
/// old manual-only Refill flow applies, unchanged.
model WarehouseAutoRefillConfig {
  id        String   @id @default(uuid())
  vendorId  String   @unique
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
}

model CollectionPolicyConfig {
  id                      String   @id @default(uuid())
  vendorId                String   @unique
  vendor                  Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  enabled                 Boolean  @default(false)
  minOutstandingThreshold Float    @default(1000)
  minCollectionPercentage Float    @default(90)
  allowedShortfall        Float    @default(300)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([vendorId])
}

/// Cash Customer Collection Policy — vendor-configurable proportional-settlement
/// credit control for CASH customers (docs/features/cash-customer-collection-policy.md).
/// required = floor10(max((balance+charge)/(N+1), ceiling ? (balance+charge)-ceiling : 0)).
/// Missing row = policy disabled (same convention as CollectionPolicyConfig).
model CashCollectionPolicyConfig {
  id                      String   @id @default(uuid())
  vendorId                String   @unique
  vendor                  Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  enabled                 Boolean  @default(false)
  allowedCreditDeliveries Int      @default(2)      // N; required = exposure/(N+1); 0 = COD
  minExposureFloor        Float    @default(500)
  maxOutstandingCeiling   Float?                    // null = no absolute ceiling
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([vendorId])
}

model ReminderSendLog {
  id               String   @id @default(uuid())
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  trigger          String   // 'manual' | 'cron'
  mode             String   // 'eligible' | 'single' | 'selected'
  month            String   // YYYY-MM
  sent             Int
  skipped          Int
  includeStatement Boolean  @default(false)
  dryRun           Boolean  @default(false)
  minBalance       Float?   // threshold used (eligible mode)
  paymentType      String?  // 'MONTHLY' | 'CASH' — null = both
  vanId            String?  // delivery-schedule van filter, if applied
  dayOfWeek        Int?     // delivery-schedule day filter (1=Mon … 6=Sat), if applied
  force            Boolean  @default(false)
  details          Json?    // per-customer results: [{ customerId, name, balance, status }]
  createdAt        DateTime @default(now())

  @@index([vendorId, createdAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Driver Last-Known Location (persistent, DB-backed)
// Redis holds the live stream; this table holds the last-known record so
// offline drivers are not silently lost when the Redis key expires.
// ──────────────────────────────────────────────────────────────────────────────

model DriverLastLocation {
  id           String   @id @default(uuid())
  driverId     String   @unique
  driver       User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  speed        Float?
  bearing      Float?
  /// ONLINE | DELIVERING | AWAY — last self-reported status
  status       String   @default("ONLINE")
  vanId        String?
  dailySheetId String?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vendorId])
  @@index([vendorId, lastSeenAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Bottle Damage Cases
// ──────────────────────────────────────────────────────────────────────────────

model DamageCase {
  id               String             @id @default(uuid())
  vendorId         String
  vendor           Vendor             @relation(fields: [vendorId], references: [id])
  customerId       String
  customer         Customer           @relation(fields: [customerId], references: [id])
  productId        String
  product          Product            @relation(fields: [productId], references: [id])
  driverId         String
  driver           User               @relation("DriverDamageCases", fields: [driverId], references: [id])
  dailySheetItemId String?
  dailySheetItem   DailySheetItem?    @relation(fields: [dailySheetItemId], references: [id])
  caseType         DamageCaseType     @default(DAMAGE)
  severity         DamageSeverity?
  bottleCount      Int
  description      String?
  lossReason       BottleLossReason?
  photoKeys        String[]
  status           DamageCaseStatus   @default(REPORTED)
  version          Int                @default(0)
  chargeAmount     Float?
  writeOffCategory WriteOffCategory?
  reviewNote       String?
  reviewedById     String?
  reviewedBy       User?              @relation("DamageCaseReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  transactionId    String?            @unique
  transaction      Transaction?       @relation(fields: [transactionId], references: [id])
  auditLogs        DamageCaseAuditLog[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([vendorId, status])
  @@index([customerId])
  @@index([driverId])
}

model DamageCaseAuditLog {
  id           String     @id @default(uuid())
  damageCaseId String
  damageCase   DamageCase @relation(fields: [damageCaseId], references: [id])
  actorId      String
  actorRole    String
  action       String
  payload      Json?
  createdAt    DateTime   @default(now())

  @@index([damageCaseId])
  @@index([damageCaseId, createdAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Customer Communication Center
// See docs/features/customer-communication-center.md (LOCKED architecture).
// One Conversation per customer (running thread, re-keyed 2026-07-17 from the
// original per-DailySheetItem design). ConversationMessage keeps its own
// dailySheetItemId — that's the per-message "which delivery is this about"
// tag/link; it was evolved in place from DeliveryItemNote (table renamed, ids
// preserved).
// ──────────────────────────────────────────────────────────────────────────────

model Conversation {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Denormalized "most recently discussed delivery" — a rollup written ONLY
  // inside the message-send transaction (never on mere get-or-create/open),
  // so opening a delivery card never mutates a thread that has no messages
  // yet. Nullable: a brand-new conversation has none of this until the first
  // real message. driverId/vanId are re-synced on swap-assignment and item
  // moves; authorization NEVER trusts these columns — driver access always
  // resolves the sheet's current driver.
  dailySheetItemId String?
  item             DailySheetItem? @relation(fields: [dailySheetItemId], references: [id], onDelete: SetNull)
  dailySheetId     String?
  dailySheet       DailySheet?     @relation(fields: [dailySheetId], references: [id])
  vanId            String?
  van              Van?            @relation(fields: [vanId], references: [id])
  driverId         String?
  driver           User?           @relation("ConversationDriver", fields: [driverId], references: [id])
  deliveryDate     DateTime?

  status ConversationStatus @default(OPEN)

  // Rollups updated in the same transaction as every message insert.
  lastMessageAt         DateTime?
  lastMessagePreview    String?   // ~120 chars; "🎤 Voice message" for voice
  lastMessageSenderId   String?
  lastMessageSenderRole String?   // UserRole as text — derives waitingOn
  messageCount          Int       @default(0)

  summary  String? // AI-ready (conversation summary) — unused until AI phase
  metadata Json?   // AI-ready — unused

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]
  reads    ConversationRead[]

  @@unique([vendorId, customerId])
  @@index([vendorId, lastMessageAt])
  @@index([vendorId, status, lastMessageAt])
  @@index([driverId, lastMessageAt])
  @@index([dailySheetId])
}

model ConversationMessage {
  id             String       @id @default(uuid())
  vendorId       String
  vendor         Vendor       @relation(fields: [vendorId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Kept permanently: keeps the delivery ack-gate a single-table indexed count
  // and legacy `item.notes` includes working during the phased migration.
  dailySheetItemId String
  item             DailySheetItem @relation(fields: [dailySheetItemId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User      @relation("MessageSender", fields: [createdById], references: [id])
  type             MessageType
  text             String?
  audioKey         String?   // Wasabi S3 key for voice messages
  audioDuration    Int?      // duration in seconds
  requiresAck      Boolean   @default(false) // instruction: blocks delivery until acknowledged
  acknowledgedAt   DateTime?
  acknowledgedById String?   // userId of driver who acknowledged (plain string, no relation needed)
  attachments      Json      @default("[]") // future [{key, name, mime, size}]
  transcription    String?   // AI-ready (voice transcription) — unused
  metadata         Json?     // AI-ready — unused
  deletedAt        DateTime? // soft delete (future edit/delete) — unused
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([dailySheetItemId])
  @@index([dailySheetItemId, acknowledgedAt])
  @@index([vendorId])
  @@index([conversationId, createdAt])
  @@index([dailySheetItemId, requiresAck, acknowledgedAt], map: "ConversationMessage_itemId_requiresAck_ack_idx")
}

// Per-user read watermark (NOT per-message receipts). A message is unread for
// user U iff createdAt > lastReadAt (or no row) AND createdById != U.
model ConversationRead {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ConversationReader", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime

  @@unique([conversationId, userId])
  @@index([userId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Warehouse Inventory
// ──────────────────────────────────────────────────────────────────────────────

model WarehouseStock {
  id            String   @id @default(uuid())
  vendorId      String
  productId     String
  filledCount   Int      @default(0)
  emptyCount    Int      @default(0)
  damagedCount  Int      @default(0)
  leakedCount   Int      @default(0)
  inRepairCount Int      @default(0)
  updatedAt     DateTime @updatedAt

  vendor  Vendor  @relation(fields: [vendorId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([vendorId, productId])
  @@index([vendorId])
}

model WarehouseTransaction {
  id            String                  @id @default(uuid())
  vendorId      String
  productId     String
  type          WarehouseTransactionType
  filledDelta   Int                     @default(0)
  emptyDelta    Int                     @default(0)
  damagedDelta  Int                     @default(0)
  leakedDelta   Int                     @default(0)
  repairDelta   Int                     @default(0)
  notes         String?
  dailySheetId  String?
  repairBatchId String?
  createdById   String?
  createdAt     DateTime                @default(now())

  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  dailySheet  DailySheet?  @relation(fields: [dailySheetId], references: [id])
  repairBatch RepairBatch? @relation(fields: [repairBatchId], references: [id])
  createdBy   User?        @relation("WarehouseTxCreatedBy", fields: [createdById], references: [id])

  @@index([vendorId, createdAt])
  @@index([vendorId, type])
  @@index([productId])
  @@index([dailySheetId])
}

model RepairBatch {
  id                String            @id @default(uuid())
  vendorId          String
  productId         String
  shopName          String
  bottlesSent       Int
  bottlesReturned   Int               @default(0)
  bottlesWrittenOff Int               @default(0)
  status            RepairBatchStatus @default(SENT)
  sentAt            DateTime          @default(now())
  returnedAt        DateTime?
  notes             String?
  createdById       String?

  vendor       Vendor               @relation(fields: [vendorId], references: [id])
  product      Product              @relation(fields: [productId], references: [id])
  createdBy    User?                @relation("RepairBatchCreatedBy", fields: [createdById], references: [id])
  transactions WarehouseTransaction[]

  @@index([vendorId])
  @@index([vendorId, status])
}

// ──────────────────────────────────────────────────────────────────────────────
// Staff Payroll & Financial Management — Phase 1 (Foundation)
// Schema-only foundation: SalaryStructure (recurring baseline), StaffLedgerEntry
// (append-only ad-hoc financial events), PayrollApprovalRule (data-driven
// approval gate), PayrollPeriod/PayrollEntry/PayrollSnapshot (computed payroll
// + immutable freeze), Settlement (payout record). No services/controllers/UI
// yet, and no Crew Cash Distribution model — that is a later phase; this
// module's tables are deliberately generic (e.g. PayrollApprovalRule.categoryKey)
// so it can be added later as new rows, not new columns.
//
// Every money field below is Int (whole rupees) — a deliberate deviation from
// the rest of the codebase's Float money convention: this business has no
// fractional currency (no paisa in use), so Int avoids float rounding drift
// across a ledger that must sum exactly.
// ──────────────────────────────────────────────────────────────────────────────

// Recurring baseline pay pattern. Only one value today, but kept as an enum
// (not a String) so WEEKLY/BIWEEKLY etc. are a one-line addition later.
enum PayFrequency {
  MONTHLY
}

enum StaffLedgerCategory {
  ADVANCE
  EXPENSE_REIMBURSEMENT
  BONUS
  INCENTIVE
  OVERTIME
  PENALTY
  DEDUCTION
  LEAVE_UNPAID
  LEAVE_PAID
  ADJUSTMENT
  REVERSAL
  CORRECTION
  // Crew Cash Distribution sync (docs/features/crew-operational-cash-distribution.md
  // §6) — always a debit against the recipient employee. Broken out as its own
  // category (not folded into DEDUCTION) so a Crew Cash entry is traceable back to
  // its source in the employee's own ledger, per the doc's "why the vendor might
  // want it broken out separately" reasoning — maps into the PayrollEntry's
  // otherDeductions bucket, same as DEDUCTION/ADJUSTMENT (no engine change).
  CREW_CASH
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  VOIDED
}

enum StaffLedgerAuditAction {
  CREATED
  EDITED
  VOIDED
  APPROVED
  REVERSED
  CORRECTED
  ROLLED_INTO_PAYROLL
}

enum PayrollAuditAction {
  GENERATED
  REGENERATED
  APPROVED
  LOCKED
  UNLOCKED
  SETTLED
}

enum CrewCashCategory {
  MEAL
  TEA
  WATER
  SNACKS
  OPERATIONAL_CASH
  EMERGENCY_CASH
  OTHER
}

enum CrewCashAuditAction {
  CREATED
  EDITED
  DELETED
  APPROVED
  SYNCED
  REVERSED
  CORRECTED
}

enum PayrollPeriodStatus {
  OPEN
  REVIEW
  LOCKED
  PAID
}

enum PayrollEntryStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  LOCKED
  SETTLED
}

enum SettlementMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
}

// Versioned recurring baseline salary per employee. A rate change is a new
// row with a fresh effectiveFrom (and the prior row's effectiveTo closed
// out) — rows are never edited in place once effective, mirroring the
// append-only intent of StaffLedgerEntry.
model SalaryStructure {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])
  userId   String
  user     User   @relation("SalaryStructureEmployee", fields: [userId], references: [id])

  baseAmount   Int // whole rupees — see module note above
  payFrequency PayFrequency @default(MONTHLY)

  effectiveFrom DateTime
  effectiveTo   DateTime? // null = current

  // Reserved for future standing allowances, e.g. [{label, amount}]. No logic
  // consumes this in Phase 1 — the field is reserved only.
  recurringLineItems Json?

  createdById String
  createdBy   User     @relation("SalaryStructureCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([vendorId, userId, effectiveFrom])
}

// Append-only staff ledger — every non-salary financial event (advance,
// bonus, penalty, etc.) against an employee. Entries are never deleted or
// mutated in place; corrections/reversals are new rows linked back via
// reversedEntryId so the full chain for an entry is queryable.
model StaffLedgerEntry {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])
  userId   String
  user     User   @relation("StaffLedgerEntryEmployee", fields: [userId], references: [id])

  category StaffLedgerCategory
  amount   Int // signed — positive = credit toward employee, negative = debit against employee

  effectiveDate DateTime // date this counts against for period attribution — may differ from createdAt
  description   String?

  status LedgerEntryStatus @default(PENDING)

  createdById  String
  createdBy    User      @relation("StaffLedgerEntryCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("StaffLedgerEntryApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  // Set once this entry is rolled into a locked payroll period; null before.
  payrollEntryId String?
  payrollEntry   PayrollEntry? @relation(fields: [payrollEntryId], references: [id])

  // Self-relation: a REVERSAL/CORRECTION row points back at the entry it
  // reverses/corrects — supports querying the full reversal chain for entry X.
  reversedEntryId String?
  reversedEntry   StaffLedgerEntry?  @relation("StaffLedgerEntryReversal", fields: [reversedEntryId], references: [id])
  reversalEntries StaffLedgerEntry[] @relation("StaffLedgerEntryReversal")

  auditLogs StaffLedgerAuditLog[]

  // Inverse of CrewCashDistribution.syncedLedgerEntry — set when this entry was
  // created by a Crew Cash sync-at-close rather than typed directly.
  crewCashSource CrewCashDistribution?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, userId, effectiveDate])
  @@index([payrollEntryId])
}

// Mirrors DamageCaseAuditLog's audit-trail shape, adapted with a typed action
// enum + separate before/after snapshots. `reason` is mandatory at the
// application layer for REVERSED/CORRECTED but nullable here since CREATED
// has no reason.
model StaffLedgerAuditLog {
  id            String                 @id @default(uuid())
  ledgerEntryId String
  ledgerEntry   StaffLedgerEntry       @relation(fields: [ledgerEntryId], references: [id])
  actorId       String
  actor         User                   @relation(fields: [actorId], references: [id])
  actorRole     UserRole
  action        StaffLedgerAuditAction
  beforeJson    Json?
  afterJson     Json?
  reason        String?
  createdAt     DateTime               @default(now())

  @@index([ledgerEntryId])
  @@index([ledgerEntryId, createdAt])
}

// Data-driven approval gate per vendor. categoryKey is a free-form key this
// table does not interpret (today's StaffLedgerCategory values; later e.g.
// "CREW_CASH_EMERGENCY" from an unrelated future module) — new categories are
// just new rows, never a schema change.
model PayrollApprovalRule {
  id               String   @id @default(uuid())
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  categoryKey      String
  requiresApproval Boolean  @default(false)
  thresholdAmount  Int? // null = requires approval regardless of amount (when requiresApproval=true); ignored when requiresApproval=false
  updatedById      String
  updatedBy        User     @relation(fields: [updatedById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([vendorId, categoryKey])
  @@index([vendorId])
}

// Per-vendor payroll singleton (mirrors CollectionPolicyConfig's convention).
model PayrollVendorConfig {
  id              String   @id @default(uuid())
  vendorId        String   @unique
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  cutoffDay       Int      @default(1) // day of month the pay period starts/ends — vendor-configurable, not hardcoded to calendar month
  autoLockEnabled Boolean  @default(false)
  updatedById     String
  updatedBy       User     @relation(fields: [updatedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([vendorId])
}

// One row per vendor per pay period (typically monthly, per PayrollVendorConfig.cutoffDay).
model PayrollPeriod {
  id          String              @id @default(uuid())
  vendorId    String
  vendor      Vendor              @relation(fields: [vendorId], references: [id])
  periodLabel String // e.g. "2026-08"
  startDate   DateTime
  endDate     DateTime
  status      PayrollPeriodStatus @default(OPEN)
  lockedAt    DateTime?
  lockedById  String?
  lockedBy    User?               @relation(fields: [lockedById], references: [id])
  paidAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt // last status transition (OPEN/REVIEW/LOCKED/PAID), independent of the dedicated lockedAt/paidAt timestamps

  entries PayrollEntry[]

  @@unique([vendorId, periodLabel])
  @@index([vendorId])
}

// One row per employee per period — the computed payroll for that employee,
// assembled from SalaryStructure + posted StaffLedgerEntry rows for the
// period. Frozen into a PayrollSnapshot at each lock.
model PayrollEntry {
  id       String        @id @default(uuid())
  periodId String
  period   PayrollPeriod @relation(fields: [periodId], references: [id])
  userId   String
  user     User          @relation("PayrollEntryEmployee", fields: [userId], references: [id])
  vendorId String
  vendor   Vendor        @relation(fields: [vendorId], references: [id])

  baseSalary      Int @default(0)
  bonuses         Int @default(0)
  overtime        Int @default(0)
  incentives      Int @default(0)
  advances        Int @default(0)
  expenses        Int @default(0)
  penalties       Int @default(0)
  otherDeductions Int @default(0)
  carryForwardIn  Int @default(0)
  finalPayable    Int

  status       PayrollEntryStatus @default(DRAFT)
  managerNotes String?

  approvedById String?
  approvedBy   User?     @relation("PayrollEntryApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries StaffLedgerEntry[]
  snapshots     PayrollSnapshot[]
  settlements   Settlement[]
  auditLogs     PayrollEntryAuditLog[]

  @@unique([periodId, userId])
  @@index([vendorId, userId])
}

// Immutable frozen breakdown of a PayrollEntry at lock time. One-to-many —
// re-locking after an unlock creates a NEW snapshot, never overwrites; the
// latest by createdAt is the "current" snapshot for an entry.
model PayrollSnapshot {
  id             String       @id @default(uuid())
  payrollEntryId String
  payrollEntry   PayrollEntry @relation(fields: [payrollEntryId], references: [id])
  breakdownJson  Json // full frozen breakdown copy
  ledgerEntryIds Json // array of the StaffLedgerEntry ids included in this computation
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([payrollEntryId, createdAt])
}

// Per-entity audit trail for PayrollEntry/PayrollPeriod state transitions,
// mirroring DamageCaseAuditLog/StaffLedgerAuditLog exactly. A period-wide
// action (e.g. locking the whole period) writes one row per affected
// PayrollEntry — same actor/timestamp/reason on each — rather than a
// separate period-level log table, so an entry's own timeline always shows
// everything that happened to it without joining across two log tables.
// reason is enforced as mandatory at the application layer for
// UNLOCKED (Payroll Doc §14 — unlock always requires a reason) but nullable
// here since GENERATED/APPROVED/LOCKED don't require one.
model PayrollEntryAuditLog {
  id             String            @id @default(uuid())
  payrollEntryId String
  payrollEntry   PayrollEntry      @relation(fields: [payrollEntryId], references: [id])
  actorId        String
  actor          User              @relation(fields: [actorId], references: [id])
  actorRole      UserRole
  action         PayrollAuditAction
  beforeJson     Json?
  afterJson      Json?
  reason         String?
  createdAt      DateTime          @default(now())

  @@index([payrollEntryId])
  @@index([payrollEntryId, createdAt])
}

// One or more per PayrollEntry — supports partial payment across multiple
// installments/methods.
model Settlement {
  id             String           @id @default(uuid())
  payrollEntryId String
  payrollEntry   PayrollEntry     @relation(fields: [payrollEntryId], references: [id])
  vendorId       String
  vendor         Vendor           @relation(fields: [vendorId], references: [id])
  amount         Int
  method         SettlementMethod
  referenceNote  String?
  paidById       String
  paidBy         User             @relation(fields: [paidById], references: [id])
  paidAt         DateTime
  createdAt      DateTime         @default(now())

  @@index([payrollEntryId])
  @@index([vendorId])
}
